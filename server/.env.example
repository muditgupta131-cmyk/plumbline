FINNHUB_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=

YAHOO_ENABLED=true
MARKET_DAILY_CALL_BUDGET=220
MARKET_SAMPLE_FALLBACK=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
