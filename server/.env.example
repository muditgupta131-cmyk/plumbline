NODE_ENV=development
PORT=5050
CLIENT_URL=http://localhost:5273

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/investiq

JWT_ACCESS_SECRET=replace-with-a-64-char-random-string
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

GOOGLE_CLIENT_ID=
